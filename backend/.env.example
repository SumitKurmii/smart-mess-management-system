# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb://localhost:27017/smart_mess
MONGODB_DB_NAME=smart_mess

# Security & Authentication
JWT_SECRET=replace_with_a_secure_jwt_secret_min_32_characters
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost:5173

# Operational Mess Timezone (Standard IANA timezone string)
MESS_TIMEZONE=Asia/Kolkata

# Initial Administrator Provisioning (Used strictly by npm run seed:admin)
ADMIN_INITIAL_NAME=System Administrator
ADMIN_INITIAL_EMAIL=admin@mess.local
ADMIN_INITIAL_PASSWORD=replace_with_strong_password_min_8_chars
